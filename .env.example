# ===== paper-rag-fronted 环境配置（复制为 .env 后按需修改）=====

# Agent 服务地址（Vite dev proxy 转发目标）
VITE_AGENT_BASE_URL=http://localhost:8001

# RAG 服务地址（Vite dev proxy 转发目标，文档库页直连 RAG 用）
VITE_RAG_BASE_URL=http://localhost:8080

# RAG 服务 API Key（服务间鉴权，X-API-Key 头）
# 留空 = RAG 开发模式（server.api_key 为空时不校验）
VITE_RAG_API_KEY=
